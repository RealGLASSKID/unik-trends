rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Change owner@example.com to the real owner email (same as NEXT_PUBLIC_ADMIN_EMAIL).
    function owner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['glasskid01@gmail.com', 'uniktrends83@gmail.com'];
    }
    function admin() {
      return owner()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(db)/documents/admins/$(request.auth.token.email.lower())));
    }

    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if owner();
    }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /orders/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.status == 'Pending' || request.resource.data.status == 'Booked');
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || admin());
      allow update: if admin()
        || (request.auth != null
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.paymentStatus == 'paid'
            && resource.data.paymentStatus == 'unpaid');
    }
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if admin();
    }
  }
}
