rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Owner = the email in NEXT_PUBLIC_ADMIN_EMAIL (change below). Other admins are added from Admin > Team.
    // Admins must have a verified email, so nobody can claim an admin email without owning it.
    function owner() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == 'owner@example.com'; }
    function admin() { return owner() || (request.auth != null && request.auth.token.email_verified == true && exists(/databases/$(db)/documents/admins/$(request.auth.token.email.lower()))); }

    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if owner();
    }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /users/{uid} { allow read: if request.auth != null && request.auth.uid == uid || admin(); allow write: if request.auth != null && request.auth.uid == uid; }
    match /orders/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.status == 'Pending' || request.resource.data.status == 'Booked');
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || admin());
      // Customer may mark their own order paid after Paystack success; admin can update anything
      allow update: if admin()
        || (request.auth != null
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.paymentStatus == 'paid'
            && resource.data.paymentStatus == 'unpaid');
    }
  }
}
