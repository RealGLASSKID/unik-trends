NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloudinary (image uploads). Preset must be an UNSIGNED upload preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# The owner's login email. This account gets the /admin dashboard.
NEXT_PUBLIC_ADMIN_EMAIL=owner@example.com
# Paystack public key (pk_test_... or pk_live_...). Leave empty until the owner provides it —
# checkout UI still works; payment button activates when this is set.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
